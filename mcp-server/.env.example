# ============================================================================
# Secrets Notion — chargés UNIQUEMENT par le conteneur mcp-server.
# Copier en mcp-server/.env :
#   cp mcp-server/.env.example mcp-server/.env
# Le backend ne reçoit jamais ces valeurs (principe de moindre privilège).
# Ne jamais committer le fichier .env.
# ============================================================================

# Clé de l'intégration interne Notion, et ID de la base (partagée avec l'intégration)
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Facultatif : noms des propriétés de la base (utilisées si elles existent)
NOTION_TAGS_PROPERTY=Tags
NOTION_STATUS_PROPERTY=Status
NOTION_STATUS_VALUE=Approved

# Facultatif, pour notion/create_notion_database.py : page qui accueillera la base
NOTION_PARENT_PAGE_ID=
