# ============================================================================
# Modèle de configuration — copier en .env à la racine du projet :
#   cp .env.example .env
# Lu par docker compose (ports) et par les services backend et mcp-server
# (env_file). Ne jamais committer le fichier .env.
# ============================================================================

# --- Ports exposés sur l'hôte ---------------------------------------------
FRONTEND_PORT=3333
BACKEND_PORT=8020
MCP_PORT=8021

# --- Moteur IA (backend) ----------------------------------------------------
# ollama (local, par défaut) ou gemini
LLM_PROVIDER=ollama
# Modèle vision servi par Ollama sur la machine hôte
OLLAMA_MODEL=gemma4:e4b
LLM_TEMPERATURE=0.0
# Requise seulement si LLM_PROVIDER=gemini (GEMINI_API_KEY est aussi accepté)
GOOGLE_API_KEY=

# --- Traitement de l'image (backend) ----------------------------------------
# Côté maximal en pixels avant conversion WebP, et qualité WebP
IMAGE_RESOLUTION=768
IMAGE_QUALITY=65

# --- Mode DRY_RUN (backend) -------------------------------------------------
# true : aucun appel IA ; le prompt et une estimation de tokens vont dans les logs
DRY_RUN=false

# --- Connecteur Notion (mcp-server) -----------------------------------------
# Clé de l'intégration interne Notion, et ID de la base (partagée avec l'intégration)
NOTION_API_KEY=
NOTION_DATABASE_ID=
# Facultatif : noms des propriétés de la base (utilisées si elles existent)
NOTION_TAGS_PROPERTY=Tags
NOTION_STATUS_PROPERTY=Status
NOTION_STATUS_VALUE=Approved
